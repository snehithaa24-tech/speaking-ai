# ==============================================================================
# SAHAYAK AI - Master Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - NEVER commit real secrets or production credentials to source control.
# - The backend handles GEMINI_API_KEY, SECRET_KEY, and DATABASE_URL.
# - Vite ONLY exposes variables prefixed with VITE_ to the browser client bundle.
#   NEVER prefix backend secret keys with VITE_ to prevent client-side credential leaks.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini Live API (Backend Only - Mandatory for Voice AI)
# ------------------------------------------------------------------------------
# Obtain your API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp

# ------------------------------------------------------------------------------
# 2. Database Configuration (Dual-Tier: SQLite Local Dev / Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Local Development (Zero setup SQLite - Default):
DATABASE_URL=sqlite:///./sahayak.db

# Production Supabase PostgreSQL (via Supavisor Transaction Pooler on Port 6543):
# Uncomment and configure for staging/production deployment:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[ENCODED_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 3. Security & Cryptographic Session Tokens (Backend Only)
# ------------------------------------------------------------------------------
# High-entropy cryptographic secret for signing voice session tokens (min 32 chars):
SECRET_KEY=generate_a_secure_random_32_character_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. Google OAuth 2.0 (Optional in Local Dev / Required for User Accounts)
# ------------------------------------------------------------------------------
ENABLE_OAUTH=false
# Public Client ID used by both Frontend (VITE_GOOGLE_CLIENT_ID) and Backend (GOOGLE_CLIENT_ID):
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_IF_USING_AUTH_CODE_FLOW
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 5. Network & URLs
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000

# ------------------------------------------------------------------------------
# 6. Application Environment & Logging
# ------------------------------------------------------------------------------
ENVIRONMENT=development
APP_DEBUG=false
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 7. Feature Flags
# ------------------------------------------------------------------------------
ENABLE_ADMIN_PANEL=false
ENABLE_AUDIO_RECORDING=false
