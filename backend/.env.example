# SAHAYAK AI - Backend Environment Template

# GOOGLE GEMINI API
# Obtain your Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_NEW_GEMINI_API_KEY
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp

# DATABASE
DATABASE_URL=sqlite:///./sahayak.db

# FRONTEND URL (for CORS)
FRONTEND_URL=http://localhost:5173

# BACKEND SERVER CONFIGURATION
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
APP_DEBUG=false
ENVIRONMENT=development

# SECURITY
SECRET_KEY=generate_a_secure_random_32_character_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# LOGGING
LOG_LEVEL=INFO

# FEATURE FLAGS
ENABLE_OAUTH=true
ENABLE_ADMIN_PANEL=false
ENABLE_AUDIO_RECORDING=false

# GOOGLE OAUTH CONFIGURATION
# Configure in Google Cloud Console with authorized redirect URI: http://localhost:5173/auth/callback
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_IF_USING_AUTH_CODE_FLOW

